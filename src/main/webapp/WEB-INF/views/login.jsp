<%@ page contentType="text/html;charset=UTF-8" %><!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Sign in · Taskflow</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="${pageContext.request.contextPath}/assets/app.css" rel="stylesheet"></head><body class="login-page"><main class="login-shell"><section class="login-brand"><div class="brand-mark">T</div><p class="eyebrow">PEOPLE &amp; PERFORMANCE</p><h1>Great work<br>starts with clarity.</h1><p>One calm place to organize work, keep teams aligned, and see progress that matters.</p><div class="login-foot">TASKFLOW <span>·</span> WORK, IN GOOD FLOW</div></section><section class="login-form"><div class="login-mobile-mark"><span class="brand-mark small-mark">T</span><span>TASKFLOW</span></div><p class="eyebrow">WELCOME BACK</p><h2>Sign in to your workspace</h2><p class="muted mb-4">Use your organization account to continue.</p><% if(request.getAttribute("error")!=null){%><div class="alert alert-danger py-2"><%=request.getAttribute("error")%></div><%}%><form autocomplete="off" method="post" action="${pageContext.request.contextPath}/login" data-validate><label class="form-label" for="username">Username</label><input class="form-control form-control-lg mb-3" id="username" name="username" autocomplete="off" required autofocus><label class="form-label" for="password">Password</label><input class="form-control form-control-lg mb-4" id="password" name="password" type="password" autocomplete="off" required><button class="btn btn-primary btn-lg w-100">Sign in <span aria-hidden="true">→</span></button></form><div class="demo-box"><strong>Demo access</strong><span>admin · manager · employee</span><span>Password: pass@123</span></div><p class="login-copyright">Secure team workspace · Session expires after 30 minutes of inactivity</p></section></main><script src="${pageContext.request.contextPath}/assets/app.js"></script></body></html>
