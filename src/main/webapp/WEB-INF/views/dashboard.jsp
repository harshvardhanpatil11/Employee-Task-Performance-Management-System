<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.*,com.etpms.model.User" %><% User me=(User)session.getAttribute("user");Map<String,Integer> stats=(Map<String,Integer>)request.getAttribute("stats");List<Map<String,Object>> tasks=(List<Map<String,Object>>)request.getAttribute("tasks");List<Map<String,Object>> employees=(List<Map<String,Object>>)request.getAttribute("employees");int pct=stats.get("total")==0?0:(int)(100.0*stats.get("completed")/stats.get("total"));String role=me.role.toLowerCase();%><!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Dashboard · Taskflow</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="${pageContext.request.contextPath}/assets/app.css" rel="stylesheet"></head><body><div class="app-layout"><aside class="sidebar"><a class="sidebar-brand" href="${pageContext.request.contextPath}/dashboard"><span class="brand-mark small-mark">T</span>TASKFLOW</a><div class="nav-label">WORKSPACE</div><a class="side-link active" href="${pageContext.request.contextPath}/dashboard"><span>◫</span> Overview</a><a class="side-link" href="${pageContext.request.contextPath}/dashboard#tasks"><span>✓</span> Tasks <b><%=stats.get("total")%></b></a><%if(!"employee".equals(role)){%><a class="side-link" href="${pageContext.request.contextPath}/admin/employees"><span>♧</span> People</a><%}%><div class="sidebar-bottom"><div class="profile-avatar"><%=me.name().isEmpty()?me.username.substring(0,1).toUpperCase():me.name().substring(0,1)%></div><div class="profile-copy"><strong><%=me.name().isEmpty()?me.username:me.name()%></strong><span><%=role%></span></div><a class="logout" href="${pageContext.request.contextPath}/logout" title="Sign out">↗</a></div></aside><main class="main-area"><header class="topbar"><div><span class="breadcrumb-small">WORKSPACE / <%=role.toUpperCase()%></span><h1>Overview</h1></div><div class="topbar-right"><span class="today"><%=java.time.LocalDate.now().format(java.time.format.DateTimeFormatter.ofPattern("EEEE, MMM d"))%></span><span class="profile-avatar top-avatar"><%=me.username.substring(0,1).toUpperCase()%></span></div></header><div class="content-area"><%String notice=(String)session.getAttribute("notice"),error=(String)session.getAttribute("error");session.removeAttribute("notice");session.removeAttribute("error");if(notice!=null){%><div class="alert alert-success alert-dismissible fade show"><%=notice%><button class="btn-close" data-bs-dismiss="alert"></button></div><%}if(error!=null){%><div class="alert alert-warning alert-dismissible fade show"><%=error%><button class="btn-close" data-bs-dismiss="alert"></button></div><%}%><section class="welcome-row"><div><p class="eyebrow">YOUR TEAM AT A GLANCE</p><h2>Good to see you, <%=me.firstName==null?me.username:me.firstName%>.</h2><p class="muted">Here’s what’s happening across your work today.</p></div><%if(!"employee".equals(role)){%><button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#newTask">＋ New task</button><%}%></section><section class="stat-grid"><div class="stat-card"><div class="stat-heading">Total tasks <span class="stat-icon lilac">▤</span></div><div class="stat-value"><%=stats.get("total")%></div><div class="stat-note">Assigned in your workspace</div></div><div class="stat-card"><div class="stat-heading">Completed <span class="stat-icon green">✓</span></div><div class="stat-value"><%=stats.get("completed")%></div><div class="stat-note">Tasks finished</div></div><div class="stat-card"><div class="stat-heading">In progress <span class="stat-icon blue">↗</span></div><div class="stat-value"><%=stats.get("inProgress")%></div><div class="stat-note">Work underway</div></div><div class="stat-card"><div class="stat-heading">Overdue <span class="stat-icon amber">◷</span></div><div class="stat-value"><%=stats.get("overdue")%></div><div class="stat-note">Past due date</div></div></section><div class="dashboard-columns"><section class="panel task-panel" id="tasks"><div class="panel-header"><div><h3><%="employee".equals(role)?"My tasks":"Recent tasks"%></h3><p>Keep an eye on the work that needs you.</p></div><span class="view-count"><%=tasks.size()%> total</span></div><div class="table-responsive"><table class="table align-middle"><thead><tr><th>TASK</th><th>ASSIGNEE</th><th>PRIORITY</th><th>DUE DATE</th><th>STATUS</th><%if("employee".equals(role)){%><th></th><%}%></tr></thead><tbody><%for(Map<String,Object> t:tasks){String status=String.valueOf(t.get("status"));%><tr><td><strong><%=t.get("title")%></strong><small class="d-block text-muted"><%=t.get("description")==null?"":t.get("description")%></small></td><td><%=t.get("first_name")%> <%=t.get("last_name")%></td><td><span class="priority priority-<%=t.get("priority").toString().toLowerCase()%>"><%=t.get("priority")%></span></td><td><%=t.get("due_date")%></td><td><span class="status status-<%=status.toLowerCase()%>"><%=status.replace('_',' ')%></span></td><%if("employee".equals(role)){%><td><form autocomplete="off" method="post" data-validate><input autocomplete="off" type="hidden" name="action" value="status"><input autocomplete="off" type="hidden" name="taskId" value="<%=t.get("id")%>"><select name="status" class="form-select form-select-sm" onchange="this.form.submit()"><option value="PENDING" <%=status.equals("PENDING")?"selected":""%>>Pending</option><option value="IN_PROGRESS" <%=status.equals("IN_PROGRESS")?"selected":""%>>In progress</option><option value="COMPLETED" <%=status.equals("COMPLETED")?"selected":""%>>Completed</option></select></form></td><%}%></tr><%}if(tasks.isEmpty()){%><tr><td colspan="6" class="empty-state">No tasks yet. Your next great piece of work starts here.</td></tr><%}%></tbody></table></div></section><section class="panel performance-panel"><div class="panel-header"><div><h3>Performance</h3><p>Completion across assigned work</p></div><span class="stat-icon lilac">◌</span></div><div class="performance-number"><%=pct%><small>%</small></div><div class="progress performance-progress" role="progressbar" aria-valuenow="<%=pct%>" aria-valuemin="0" aria-valuemax="100"><div class="progress-bar" style="width:<%=pct%>%"></div></div><div class="performance-caption"><span>Completion rate</span><strong><%=stats.get("completed")%> of <%=stats.get("total")%></strong></div><hr><div class="mini-legend"><span><i class="dot dot-complete"></i>Completed</span><strong><%=stats.get("completed")%></strong></div><div class="mini-legend"><span><i class="dot dot-progress"></i>In progress</span><strong><%=stats.get("inProgress")%></strong></div><div class="mini-legend"><span><i class="dot dot-pending"></i>Pending</span><strong><%=stats.get("pending")%></strong></div><div class="mini-legend"><span><i class="dot dot-overdue"></i>Overdue</span><strong><%=stats.get("overdue")%></strong></div></section></div><%if("admin".equals(role)&&employees!=null){%><section class="panel mt-4"><div class="panel-header"><div><h3>People</h3><p>Managers and employees in your organization</p></div><span class="view-count"><%=employees.size()%> people</span></div><div class="table-responsive"><table class="table align-middle"><thead><tr><th>NAME</th><th>EMAIL</th><th>ROLE</th><th>DEPARTMENT</th><th>JOB TITLE</th></tr></thead><tbody><%for(Map<String,Object> e:employees){%><tr><td><strong><%=e.get("first_name")%> <%=e.get("last_name")%></strong></td><td><%=e.get("email")%></td><td><span class="status status-in_progress"><%=e.get("role")%></span></td><td><%=e.get("department")%></td><td><%=e.get("job_title")%></td></tr><%}%></tbody></table></div></section><%}%></div></main></div><%if(!"employee".equals(role)){%><div class="modal fade" id="newTask" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><form autocomplete="off" method="post" data-validate><div class="modal-header"><div><p class="eyebrow mb-1">WORK MANAGEMENT</p><h5 class="modal-title">Create a task</h5></div><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><input autocomplete="off" type="hidden" name="action" value="create"><label class="form-label">Task title</label><input autocomplete="off" class="form-control mb-3" name="title" maxlength="180" required><label class="form-label">Description</label><textarea class="form-control mb-3" name="description" rows="3"></textarea><div class="row"><div class="col-6"><label class="form-label">Assignee</label><select class="form-select mb-3" name="assignee" required><%if(employees!=null)for(Map<String,Object> e:employees)if("EMPLOYEE".equals(e.get("role"))){%><option value="<%=e.get("id")%>"><%=e.get("first_name")%> <%=e.get("last_name")%></option><%}%></select></div><div class="col-6"><label class="form-label">Priority</label><select class="form-select mb-3" name="priority"><option>MEDIUM</option><option>LOW</option><option>HIGH</option><option>URGENT</option></select></div></div><div class="row"><div class="col-6"><label class="form-label">Start date</label><input autocomplete="off" type="date" class="form-control" name="startDate" required></div><div class="col-6"><label class="form-label">Due date</label><input autocomplete="off" type="date" class="form-control" name="dueDate" required></div></div></div><div class="modal-footer"><button class="btn btn-light" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary">Create task</button></div></form></div></div></div><%}%><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script><script src="${pageContext.request.contextPath}/assets/app.js"></script></body></html>
