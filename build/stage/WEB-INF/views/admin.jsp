<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.*,com.etpms.model.User" %><%boolean people=Boolean.TRUE.equals(request.getAttribute("people"));List<Map<String,Object>> rows=(List<Map<String,Object>>)request.getAttribute("rows"),departments=(List<Map<String,Object>>)request.getAttribute("departments");User me=(User)session.getAttribute("user");%><!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%=people?"People":"Departments"%> · Taskflow</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="${pageContext.request.contextPath}/assets/app.css" rel="stylesheet"></head><body><div class="app-layout"><aside class="sidebar"><a class="sidebar-brand" href="${pageContext.request.contextPath}/dashboard"><span class="brand-mark small-mark">T</span>TASKFLOW</a><div class="nav-label">WORKSPACE</div><a class="side-link" href="${pageContext.request.contextPath}/dashboard">◫ &nbsp; Overview</a><a class="side-link active" href="${pageContext.request.contextPath}/admin/employees">♧ &nbsp; People</a><a class="side-link" href="${pageContext.request.contextPath}/admin/departments">▦ &nbsp; Departments</a><div class="sidebar-bottom"><div class="profile-avatar">A</div><div class="profile-copy"><strong><%=me.username%></strong><span>administrator</span></div><a class="logout" href="${pageContext.request.contextPath}/logout">↗</a></div></aside><main class="main-area"><header class="topbar"><div><span class="breadcrumb-small">WORKSPACE / ADMIN</span><h1><%=people?"People":"Departments"%></h1></div></header><div class="content-area"><%String notice=(String)session.getAttribute("notice"),error=(String)session.getAttribute("error");session.removeAttribute("notice");session.removeAttribute("error");if(notice!=null){%><div class="alert alert-success"><%=notice%></div><%}if(error!=null){%><div class="alert alert-warning"><%=error%></div><%}%><section class="welcome-row"><div><p class="eyebrow">ORGANIZATION DIRECTORY</p><h2><%=people?"People and access":"Team departments"%></h2><p class="muted">Manage the people and structure behind your team's work.</p></div><button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#create">＋ <%=people?"Add person":"Add department"%></button></section><section class="panel"><div class="table-responsive"><table class="table align-middle"><thead><tr><%if(people){%><th>NAME</th><th>USERNAME</th><th>EMAIL</th><th>ROLE</th><th>DEPARTMENT</th><th>TITLE</th><th></th><%}else{%><th>DEPARTMENT</th><th>DESCRIPTION</th><th>PEOPLE</th><th></th><%}%></tr></thead><tbody><%for(Map<String,Object> r:rows){%><tr><%if(people){%><td><strong><%=r.get("first_name")%> <%=r.get("last_name")%></strong></td><td><%=r.get("username")%></td><td><%=r.get("email")%></td><td><span class="status status-in_progress"><%=r.get("role")%></span></td><td><%=r.get("department")==null?"—":r.get("department")%></td><td><%=r.get("job_title")==null?"—":r.get("job_title")%></td><td><div class="d-flex gap-2"><button class="btn btn-sm btn-light" data-bs-toggle="modal" data-bs-target="#edit<%=r.get("id")%>">Edit</button><form autocomplete="off" method="post" action="${pageContext.request.contextPath}/admin/employees" onsubmit="return confirm('Delete this employee and their account?')"><input autocomplete="off" type="hidden" name="entity" value="employee"><input autocomplete="off" type="hidden" name="action" value="delete"><input autocomplete="off" type="hidden" name="id" value="<%=r.get("id")%>"><button class="btn btn-sm btn-outline-danger">Delete</button></form></div><div class="modal fade" id="edit<%=r.get("id")%>" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><form autocomplete="off" method="post" action="${pageContext.request.contextPath}/admin/employees"><div class="modal-header"><h5 class="modal-title">Edit employee</h5><button class="btn-close" data-bs-dismiss="modal" type="button"></button></div><div class="modal-body"><input autocomplete="off" type="hidden" name="entity" value="employee"><input autocomplete="off" type="hidden" name="action" value="update"><input autocomplete="off" type="hidden" name="id" value="<%=r.get("id")%>"><label class="form-label">First name</label><input autocomplete="off" required class="form-control mb-3" name="first" value="<%=r.get("first_name")%>"><label class="form-label">Last name</label><input autocomplete="off" required class="form-control mb-3" name="last" value="<%=r.get("last_name")%>"><label class="form-label">Email</label><input autocomplete="off" required type="email" class="form-control mb-3" name="email" value="<%=r.get("email")%>"><label class="form-label">Job title</label><input autocomplete="off" class="form-control mb-3" name="job" value="<%=r.get("job_title")==null?"":r.get("job_title")%>"><label class="form-label">Department</label><select class="form-select" name="department"><option value="">No department</option><%for(Map<String,Object>d:departments){%><option value="<%=d.get("id")%>" <%=Objects.equals(String.valueOf(d.get("id")),String.valueOf(r.get("department_id")))?"selected":""%>><%=d.get("name")%></option><%}%></select></div><div class="modal-footer"><button class="btn btn-primary">Save changes</button></div></form></div></div></div></td><%}else{%><td><strong><%=r.get("name")%></strong></td><td><%=r.get("description")==null?"—":r.get("description")%></td><td><%=r.get("employee_count")%></td><td><form autocomplete="off" method="post" action="${pageContext.request.contextPath}/admin/departments" onsubmit="return confirm('Delete this department? Employees will become unassigned.')"><input autocomplete="off" type="hidden" name="entity" value="department"><input autocomplete="off" type="hidden" name="action" value="delete"><input autocomplete="off" type="hidden" name="id" value="<%=r.get("id")%>"><button class="btn btn-sm btn-outline-danger">Delete</button></form></td><%}%></tr><%}%></tbody></table></div></section></div></main></div><div class="modal fade" id="create" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><form autocomplete="off" method="post" action="${pageContext.request.contextPath}/admin/<%=people?"employees":"departments"%>" data-validate><div class="modal-header"><h5 class="modal-title">Add <%=people?"a person":"a department"%></h5><button class="btn-close" data-bs-dismiss="modal" type="button"></button></div><div class="modal-body"><input autocomplete="off" type="hidden" name="entity" value="<%=people?"employee":"department"%>"><input autocomplete="off" type="hidden" name="action" value="create"><%if(people){%><label class="form-label">First name</label><input autocomplete="off" required class="form-control mb-3" name="first"><label class="form-label">Last name</label><input autocomplete="off" required class="form-control mb-3" name="last"><label class="form-label">Email</label><input autocomplete="off" required type="email" class="form-control mb-3" name="email"><label class="form-label">Username</label><input autocomplete="off" required minlength="3" maxlength="60" pattern="[A-Za-z0-9._-]+" class="form-control mb-3" name="username"><label class="form-label">Initial password (at least 5 characters)</label><input autocomplete="off" required minlength="5" type="password" class="form-control mb-3" name="password"><label class="form-label">Role</label><select class="form-select mb-3" name="role"><option value="EMPLOYEE">Employee</option><option value="MANAGER">Manager</option></select><label class="form-label">Job title</label><input autocomplete="off" class="form-control mb-3" name="job"><label class="form-label">Department</label><select class="form-select" name="department"><option value="">No department</option><%for(Map<String,Object>d:departments){%><option value="<%=d.get("id")%>"><%=d.get("name")%></option><%}%></select><%}else{%><label class="form-label">Department name</label><input autocomplete="off" required maxlength="100" class="form-control mb-3" name="name"><label class="form-label">Description</label><textarea class="form-control" name="description" rows="3"></textarea><%}%></div><div class="modal-footer"><button class="btn btn-light" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary">Add <%=people?"person":"department"%></button></div></form></div></div></div><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script><script src="${pageContext.request.contextPath}/assets/app.js"></script></body></html>
