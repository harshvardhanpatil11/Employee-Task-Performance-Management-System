<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee" version="6.0" metadata-complete="false">
 <display-name>Employee Task &amp; Performance Management</display-name>
 <listener><listener-class>com.etpms.AppListener</listener-class></listener>
 <filter><filter-name>auth</filter-name><filter-class>com.etpms.AuthFilter</filter-class></filter>
 <filter-mapping><filter-name>auth</filter-name><url-pattern>/*</url-pattern></filter-mapping>
 <welcome-file-list><welcome-file>login</welcome-file></welcome-file-list>
 <session-config><session-timeout>30</session-timeout><cookie-config><http-only>true</http-only></cookie-config></session-config>
</web-app>
